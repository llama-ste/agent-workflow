# 작업 기록에 필요한 환경변수 예시.
#
# 이 파일을 ~/.config/agent-workflow/env 로 복사해 값을 채운다.
# 실제 파일에는 토큰이 들어가므로 저장소에 넣지 않는다.
#
#   mkdir -p ~/.config/agent-workflow
#   cp env.example ~/.config/agent-workflow/env
#   chmod 600 ~/.config/agent-workflow/env
#
# 셸을 열 때 자동으로 읽히게 하려면 ~/.zshrc 에 한 줄 추가한다.
#
#   [ -f ~/.config/agent-workflow/env ] && source ~/.config/agent-workflow/env

# 작업 기록을 모으는 중앙 보관소. 마크다운 폴더이며 Obsidian으로 열 수 있다.
export WORKLOG_VAULT="$HOME/worklog"

# Notion 연동에만 필요하다. 없으면 로컬 기록과 HTML 렌더링은 그대로 동작한다.
# 토큰은 https://www.notion.so/my-integrations 에서 발급한다.
export NOTION_TOKEN=

# 기록을 담을 Notion 데이터베이스. 아래 명령이 출력하는 값을 넣는다.
#   python3 scripts/sync_notion.py --init-db <부모_페이지_ID>
export NOTION_DB_ID=
